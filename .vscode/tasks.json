{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Regenerate Makefiles",
            "type": "shell",
            "command": "premake5 gmake",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "make config=debug -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "make config=release -j$(nproc)",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "group": "build",
            "problemMatcher": []
        }
    ]
}